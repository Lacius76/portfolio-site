# Copy to .env for local `netlify dev` / OAuth setup script.
# NEVER commit real values.
#
# Secrets (keep private — Netlify env + local .env only):
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN
#
# Non-secret config (safe / expected in frontend):
#   GOOGLE_CALENDAR_ID — usually "primary"
#   BOOKING_TZ — display + FreeBusy timezone, e.g. Europe/Budapest

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
BOOKING_TZ=Europe/Budapest
